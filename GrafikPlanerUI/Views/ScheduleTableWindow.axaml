<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GrafikPlanerCore.Models;assembly=GrafikPlanerCore"
        xmlns:views="clr-namespace:GrafikPlanerUI.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="GrafikPlanerUI.Views.ScheduleTableWindow"
        x:DataType="models:ScheduleRow"
        Title="Grafik Pracy"
        Background="#F8F9FA"
        WindowState="Maximized">

    <Window.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Naglowki kolumn -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="Foreground" Value="#2D3748" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,1,1"
                            Padding="4">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Komorki -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="DataGridCell /template/ ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DataGridCell /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Wylaczenie podswietlenia wiersza -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Prevent focus/selection from changing cell layout -->
        <Style Selector="DataGridCell:focus /template/ ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DataGridCell:current /template/ ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DataGridRow:focus">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="DataGridCell:focus">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Wylaczenie domyslnej czarnej ramki fokusa/zaznaczenia na komorkach -->
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell:current">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell:focus">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell:current">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>
    
    <Grid>
        <DockPanel>
            <!-- Naglowek z przyciskiem powrotu -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="&#x2190; Powrot"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="#CBD5E0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            FontSize="13"
                            Foreground="#4A5568"
                            Cursor="Hand"/>
                    <Button Content="&#x2913; Eksportuj"
                            Click="ExportButton_Click"
                            Background="#3182CE"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="12,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Grid zajmujacy cala reszta -->
            <DataGrid x:Name="ScheduleDataGrid"
                      Margin="12"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserResizeColumns="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      BorderThickness="1" 
                      BorderBrush="#E2E8F0"
                      CornerRadius="8"
                      Background="White"
                      RowBackground="White"
                      RowHeight="95">
                <DataGrid.Columns>
                
                    <DataGridTemplateColumn Header="Pracownik" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:ScheduleRow">
                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FirstName}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding NameColor}"/>
                                    <TextBlock Text="{Binding LastName}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding NameColor}"/>
                                    <TextBlock Text="{Binding Specialisation}" FontSize="10" Foreground="#2563EB"/>
                                    <TextBlock Text="{Binding VacationLine1}" FontSize="11" Foreground="{Binding VacationLine1Color}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding VacationLine2}" FontSize="11" Foreground="{Binding VacationLine2Color}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="Suma" TextAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:ScheduleRow">
                                <TextBlock Text="{Binding HoursSummaryDisplay}" 
                                           Foreground="{Binding HoursSummaryColor}"
                                           FontSize="11"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Legenda oznaczeń godzinowych — lewy dolny róg -->
        <Border x:Name="LegendPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16,0,0,16"
                Background="#FFFFFFEE"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                BoxShadow="0 2 8 0 #18000000">
            <StackPanel Spacing="4">
                <TextBlock Text="Legenda" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,4"/>
                <ItemsControl x:Name="LegendItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:LegendItem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <Border Width="28" Height="20" CornerRadius="3" Background="#EDF2F7" 
                                        BorderBrush="#CBD5E0" BorderThickness="1">
                                    <TextBlock Text="{Binding Symbol}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#2D3748"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="12" Foreground="#4A5568" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
