<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GrafikPlanerUI.Views"
        x:Class="GrafikPlanerUI.Views.ExportDialog"
        Title="Eksport grafiku"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8F9FA">

    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" ColumnDefinitions="1*,1*" ColumnSpacing="20">

        <!-- Lewa kolumna: lista pracowników -->
        <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Pracownicy do eksportu" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
            <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                <ScrollViewer>
                    <ItemsControl x:Name="EmployeeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:EmployeeSelection">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="8,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Prawa kolumna: format, opcje (funkcje) i przyciski -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Format eksportu" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748"/>
                <RadioButton x:Name="RadioExcel" Content="Excel" IsChecked="True" GroupName="Format"/>
                <RadioButton x:Name="RadioPdf" Content="PDF" GroupName="Format"/>
            </StackPanel>

            <Separator Grid.Row="1" Background="#E2E8F0" Height="1"/>

            <StackPanel Grid.Row="2" Spacing="2">
                <TextBlock Text="Funkcje eksportu" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748"/>
                <CheckBox x:Name="ChkColors" Content="Kolory tła"/>
                <CheckBox x:Name="ChkSpecialization" Content="Specjalizacja"/>
                <CheckBox x:Name="ChkHoursSummary" Content="Suma godzin"/>
                <CheckBox x:Name="ChkLegend" Content="Dołącz legendę oznaczeń"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Anuluj" Click="Cancel_Click"
                        Padding="16,8" Background="Transparent" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6"/>
                <Button Content="Eksportuj" Click="Export_Click"
                        Padding="16,8" Background="#3182CE" Foreground="White" CornerRadius="6" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
