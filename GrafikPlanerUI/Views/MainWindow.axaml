<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GrafikPlanerUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GrafikPlanerData.Models;assembly=GrafikPlanerData"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="GrafikPlanerUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Grafik Planer"
        Background="#F8F7F5"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Padding="28,14" Background="#FDFCFB" BorderBrush="#E8E5E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Zakładki po lewej -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom" Margin="0,0,0,-1">
                    <Border x:Name="TabGrafiki" 
                            Padding="18,9" 
                            CornerRadius="6,6,0,0"
                            Background="#F8F7F5"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1,1,1,0"
                            Cursor="Hand"
                            PointerPressed="OnTabGrafikiClick">
                        <TextBlock Text="Grafiki" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A"/>
                    </Border>
                    <Border x:Name="TabPracownicy" 
                            Padding="18,9" 
                            CornerRadius="6,6,0,0"
                            Background="#EFECEA"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1,1,1,1"
                            Cursor="Hand"
                            Margin="3,0,0,0"
                            PointerPressed="OnTabPracownicyClick">
                        <TextBlock Text="Pracownicy" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A"/>
                    </Border>
                    <Border x:Name="TabUstawienia" 
                            Padding="18,9" 
                            CornerRadius="6,6,0,0"
                            Background="#EFECEA"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1,1,1,1"
                            Cursor="Hand"
                            Margin="3,0,0,0"
                            PointerPressed="OnTabUstawieniaClick">
                        <TextBlock Text="Ustawienia" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A"/>
                    </Border>
                </StackPanel>
                <!-- Tytuł — prawy skrajny róg -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Grafik Planer" FontSize="15" FontWeight="SemiBold" Foreground="#3A3A3A" HorizontalAlignment="Right"/>
                    <TextBlock Text="Zarządzanie grafikami pracy" FontSize="10" Foreground="#A0A0A0" Margin="0,1,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Panel Grid.Row="1" ClipToBounds="True">
            <!-- ==================== PAGE: GRAFIKI ==================== -->
            <Border x:Name="PageGrafiki" 
                    IsVisible="True"
                    Background="#F8F7F5" 
                    Padding="28,20"
                    Opacity="1">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Grid.Column="0" Text="Twoje grafiki" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="#3A3A3A"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="+ Nowy grafik"
                                Click="OnAddNewScheduleClick"
                                Background="#5D8A6B"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Padding="18,9"
                                CornerRadius="6"
                                Cursor="Hand"
                                BorderThickness="0"/>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="StatusTextBlock" 
                                       Text="" 
                                       FontSize="12"
                                       FontWeight="SemiBold" 
                                       HorizontalAlignment="Left" />

                            <ItemsControl x:Name="ItemsList" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ScheduleInfo">
                                        <Border Margin="0,2"
                                                Padding="16,14"
                                                HorizontalAlignment="Stretch"
                                                Background="White"
                                                BorderBrush="#E8E5E0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Cursor="Hand"
                                                PointerPressed="OnScheduleItemClick"
                                                Tag="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" HorizontalAlignment="Stretch">
                                                <Border Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="8"
                                                        Background="#EDF3EF"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="G"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="#5D8A6B"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="#3A3A3A"/>
                                                    <TextBlock Text="Kliknij aby otworzyć"
                                                               FontSize="11"
                                                               Foreground="#A0A0A0"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="→"
                                                           FontSize="16"
                                                           Foreground="#A0A0A0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Click="OnDeleteScheduleClick"
                                                        Tag="{Binding}"
                                                        Background="#FDF5F5"
                                                        Foreground="#C05050"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Width="32" Height="32"
                                                        Padding="0"
                                                        CornerRadius="6"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="EmptyStateText"
                                    IsVisible="False"
                                    Background="White"
                                    CornerRadius="10"
                                    Padding="36,40"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="#E8E5E0"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="Brak grafików"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#3A3A3A"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Kliknij '+ Nowy grafik' aby utworzyć pierwszy."
                                               FontSize="12"
                                               Foreground="#A0A0A0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== PAGE: PRACOWNICY (Master-Detail) ==================== -->
            <Border x:Name="PagePracownicy" 
                    IsVisible="False"
                    Background="#F8F7F5" 
                    Padding="28,20"
                    Opacity="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Grid.Column="0" Text="Kartoteka pracowników" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="#3A3A3A"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="+ Dodaj pracownika"
                                Click="OnAddEmployeeClick"
                                Background="#5D8A6B"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Padding="18,9"
                                CornerRadius="6"
                                Cursor="Hand"
                                BorderThickness="0"/>
                    </Grid>

                    <!-- Master-Detail layout -->
                    <Grid ColumnDefinitions="270,12,*">
                        <!-- LEWA KOLUMNA: Lista pracowników -->
                        <Border Grid.Column="0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="EmployeeStatusText" 
                                               Text="" 
                                               FontSize="12"
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Left" />

                                    <ItemsControl x:Name="EmployeesList" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:EmployeeRecord">
                                                <Border Margin="0,2,0,2"
                                                        Padding="12,11"
                                                        Background="White"
                                                        BorderBrush="#E0DDD8"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Cursor="Hand"
                                                        PointerPressed="OnEmployeeItemClick"
                                                        Tag="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Grid.Column="0"
                                                                Width="34" Height="34"
                                                                CornerRadius="17"
                                                                Background="#EDF3EF"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FirstName[0]}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="#4A7A5A"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="{Binding FirstName}" 
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#1A1A1A"/>
                                                                <TextBlock Text="{Binding LastName}" 
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#1A1A1A"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Specialisation}"
                                                                       FontSize="11"
                                                                       Foreground="#5A5A5A"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <Border x:Name="EmployeeEmptyState"
                                            IsVisible="False"
                                            Background="White"
                                            CornerRadius="6"
                                            Padding="16,28"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="#E0DDD8"
                                            BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="Brak pracowników"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2A2A2A"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Dodaj pierwszego pracownika."
                                                       FontSize="12"
                                                       Foreground="#7A7A7A"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- GAP kolumna 1 (12px) jest automatyczna -->

                        <!-- PRAWA KOLUMNA: Panel szczegółów -->
                        <Border x:Name="DetailPanel"
                                Grid.Column="2"
                                Background="White"
                                BorderBrush="#E0DDD8"
                                BorderThickness="1"
                                CornerRadius="8"
                                Opacity="1">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="QuadraticEaseOut"/>
                                </Transitions>
                            </Border.Transitions>

                            <Grid>
                                <!-- Stan pusty -->
                                <StackPanel x:Name="DetailEmpty" 
                                            IsVisible="True"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" 
                                            Spacing="6">
                                    <TextBlock Text="Wybierz pracownika"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#9A9A9A"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Kliknij na element po lewej aby zobaczyć kartę"
                                               FontSize="12"
                                               Foreground="#9A9A9A"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Tryb podglądu — karta pracownika -->
                                <Grid x:Name="DetailView" IsVisible="False" Margin="32,28"
                                      RowDefinitions="Auto,Auto,Auto,Auto,*">

                                    <!-- Wiersz 0: Avatar + Dane podstawowe + przyciski -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,22">
                                        <Border Grid.Column="0"
                                                Width="76" Height="76"
                                                CornerRadius="10"
                                                Background="#EDF3EF"
                                                VerticalAlignment="Top"
                                                Margin="0,0,20,0">
                                            <TextBlock x:Name="ViewAvatar"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       Foreground="#4A7A5A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock x:Name="ViewFirstName" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                            <TextBlock x:Name="ViewLastName" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                            <TextBlock x:Name="ViewSpec" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Edytuj"
                                                Click="OnEditEmployeeClick"
                                                Background="#F0EFED"
                                                Foreground="#2A2A2A"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Padding="16,8"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top"/>
                                        <Button Grid.Column="3"
                                                Content="Usuń"
                                                Click="OnDeleteEmployeeClick"
                                                Background="#FDF5F5"
                                                Foreground="#B04040"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Padding="16,8"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Wiersz 1: Separator -->
                                    <Border Grid.Row="1" Height="1" Background="#E8E5E0" Margin="0,0,0,20"/>

                                    <!-- Wiersz 2: Kontakt -->
                                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,20">
                                        <TextBlock Text="Kontakt" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email" FontSize="13" Foreground="#5A5A5A"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ViewEmail" FontSize="13" Foreground="#1A1A1A"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Telefon" FontSize="13" Foreground="#5A5A5A" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewPhone" FontSize="13" Foreground="#1A1A1A" Margin="0,6,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Wiersz 3: Separator + Urlop -->
                                    <StackPanel Grid.Row="3" Spacing="8">
                                        <Border Height="1" Background="#E8E5E0" Margin="0,0,0,14"/>
                                        <TextBlock Text="Urlop" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Przysługujący (dni/rok)" FontSize="13" Foreground="#5A5A5A"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ViewVacationDays" FontSize="13" Foreground="#1A1A1A" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wykorzystane" FontSize="13" Foreground="#5A5A5A" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewUsedVacation" FontSize="13" Foreground="#1A1A1A" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z ubiegłego roku" FontSize="13" Foreground="#5A5A5A" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ViewUnusedVacation" FontSize="13" Foreground="#1A1A1A" Margin="0,6,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Wiersz 4: Potwierdzenie usunięcia -->
                                    <Border Grid.Row="4" x:Name="DeleteConfirmPanel" IsVisible="False"
                                            Background="#FDF5F5" CornerRadius="6" Padding="16,12" 
                                            Margin="0,20,0,0" VerticalAlignment="Bottom">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Czy na pewno chcesz usunąć tego pracownika?" 
                                                       FontSize="13" Foreground="#B04040" FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Tak, usuń" Click="OnConfirmDeleteClick"
                                                        Background="#B04040" Foreground="White" FontSize="12"
                                                        Padding="12,6" CornerRadius="5" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="Anuluj" Click="OnCancelDeleteClick"
                                                        Background="White" Foreground="#2A2A2A" FontSize="12"
                                                        Padding="12,6" CornerRadius="5" BorderBrush="#E0DDD8" BorderThickness="1" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Tryb edycji — odwzorowuje layout karty -->
                                <Grid x:Name="DetailEdit" IsVisible="False" Margin="32,28"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                    <!-- Wiersz 0: Avatar + pola imię/nazwisko/spec (jak w karcie) -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,22">
                                        <Border Grid.Column="0"
                                                Width="76" Height="76"
                                                CornerRadius="10"
                                                Background="#EDF3EF"
                                                VerticalAlignment="Top"
                                                Margin="0,0,20,0">
                                            <TextBlock x:Name="EditAvatar"
                                                       Text="?"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       Foreground="#4A7A5A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <TextBox x:Name="EmpFirstNameBox" PlaceholderText="Imię *" CornerRadius="5" Padding="10,8" FontSize="14"/>
                                            <TextBox x:Name="EmpLastNameBox" PlaceholderText="Nazwisko *" CornerRadius="5" Padding="10,8" FontSize="14"/>
                                            <ComboBox x:Name="EmpSpecBox" PlaceholderText="Specjalizacja *" CornerRadius="5" Padding="10,8" FontSize="14" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Farmaceuta/ka"/>
                                                <ComboBoxItem Content="Technik/czka farmacji"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Wiersz 1: Separator -->
                                    <Border Grid.Row="1" Height="1" Background="#E8E5E0" Margin="0,0,0,20"/>

                                    <!-- Wiersz 2: Kontakt (ten sam układ co karta) -->
                                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,20">
                                        <TextBlock Text="Kontakt" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmpEmailBox" PlaceholderText="np. jan@email.com" CornerRadius="5" Padding="10,7" FontSize="13"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Telefon" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmpPhoneBox" PlaceholderText="np. 123 456 789" CornerRadius="5" Padding="10,7" FontSize="13" Margin="0,6,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Wiersz 3: Urlop (ten sam układ co karta) -->
                                    <StackPanel Grid.Row="3" Spacing="8">
                                        <Border Height="1" Background="#E8E5E0" Margin="0,0,0,14"/>
                                        <TextBlock Text="Urlop" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Przysługujący (dni/rok)" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmpVacationDaysBox" PlaceholderText="np. 26" CornerRadius="5" Padding="10,7" FontSize="13"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wykorzystane" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmpUsedVacationBox" PlaceholderText="np. 5" CornerRadius="5" Padding="10,7" FontSize="13" Margin="0,6,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z ubiegłego roku" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmpUnusedVacationBox" PlaceholderText="np. 3" CornerRadius="5" Padding="10,7" FontSize="13" Margin="0,6,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Wiersz 4: Błąd + przyciski -->
                                    <StackPanel Grid.Row="4" Margin="0,18,0,0" Spacing="8">
                                        <TextBlock x:Name="EmployeeDialogError"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="#B04040"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="EditSubmitBtn"
                                                    Content="Zapisz"
                                                    Click="OnEmployeeDialogSubmitClick"
                                                    Background="#5D8A6B"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="13"
                                                    Padding="20,9"
                                                    CornerRadius="6"
                                                    Cursor="Hand"
                                                    BorderThickness="0"/>
                                            <Button Content="Anuluj"
                                                    Click="OnEmployeeDialogCancelClick"
                                                    Background="#F0EFED"
                                                    Foreground="#2A2A2A"
                                                    FontSize="13"
                                                    Padding="20,9"
                                                    CornerRadius="6"
                                                    Cursor="Hand"
                                                    BorderBrush="#E0DDD8"
                                                    BorderThickness="1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ==================== PAGE: USTAWIENIA ==================== -->
            <Border x:Name="PageUstawienia" 
                    IsVisible="False"
                    Background="#F8F7F5" 
                    Padding="28,20"
                    Opacity="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ustawienia apteki" 
                               FontSize="16" FontWeight="SemiBold" Foreground="#3A3A3A" Margin="0,0,0,14"/>

                    <!-- Powiadomienie o niepokrytych godzinach -->
                    <Border x:Name="CoverageWarningPanel" DockPanel.Dock="Top"
                            IsVisible="False"
                            Background="#FFF8E1" BorderBrush="#F0D060" BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Wykryto luki w pokryciu godzin pracy"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#8B6914" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CoverageWarningDetails" Text=""
                                       FontSize="12" Foreground="#7A5C10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings layout: vertical sidebar + content -->
                    <Grid ColumnDefinitions="200,*">
                        <!-- Left sidebar menu -->
                        <Border Grid.Column="0" Background="#F0EFED" CornerRadius="8,0,0,8" Padding="0,8">
                            <StackPanel Spacing="2">
                                <Border x:Name="SettingsSubTabGodziny" 
                                        Padding="16,12" 
                                        Background="White"
                                        Cursor="Hand"
                                        PointerPressed="OnSettingsSubTabGodzinyClick">
                                    <TextBlock Text="Godziny i dni pracy" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3A"/>
                                </Border>
                                <Border x:Name="SettingsSubTabSwieta" 
                                        Padding="16,12"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        PointerPressed="OnSettingsSubTabSwietaClick">
                                    <TextBlock Text="Święta" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A"/>
                                </Border>
                                <Border x:Name="SettingsSubTabZmiany" 
                                        Padding="16,12"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        PointerPressed="OnSettingsSubTabZmianyClick">
                                    <TextBlock Text="Zmiany pracowników" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right content area -->
                        <Panel Grid.Column="1">
                        <!-- ===== SUB-TAB: Godziny i dni pracy ===== -->
                        <Border x:Name="SettingsPageGodziny" IsVisible="True" Background="White" BorderBrush="#E0DDD8" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="28,24">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="20" MaxWidth="500">
                                    <!-- Godziny otwarcia -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Godziny otwarcia" FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3A"/>
                                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Otwarcie" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                                            <TimePicker Grid.Row="0" Grid.Column="1" x:Name="SettingsOpeningTime" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Zamknięcie" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                            <TimePicker Grid.Row="1" Grid.Column="1" x:Name="SettingsClosingTime" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Border Height="1" Background="#E0DDD8"/>

                                    <!-- Dni otwarcia -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Dni otwarcia" FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3A"/>
                                        <CheckBox x:Name="ChkMonday" Content="Poniedziałek" FontSize="13"/>
                                        <CheckBox x:Name="ChkTuesday" Content="Wtorek" FontSize="13"/>
                                        <CheckBox x:Name="ChkWednesday" Content="Środa" FontSize="13"/>
                                        <CheckBox x:Name="ChkThursday" Content="Czwartek" FontSize="13"/>
                                        <CheckBox x:Name="ChkFriday" Content="Piątek" FontSize="13"/>
                                        <CheckBox x:Name="ChkSaturday" Content="Sobota" FontSize="13"/>
                                        <CheckBox x:Name="ChkSunday" Content="Niedziela" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Zapisz -->
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="SettingsStatusText" Text="" FontSize="12" FontWeight="SemiBold"/>
                                        <Button Content="Zapisz ustawienia"
                                                Click="OnSaveSettingsClick"
                                                Background="#5D8A6B"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Padding="18,9"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- ===== SUB-TAB: Święta ===== -->
                        <Border x:Name="SettingsPageSwieta" IsVisible="False" Background="White" BorderBrush="#E0DDD8" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="28,24">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" MaxWidth="600">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Dni ustawowo wolne od pracy" FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3A"/>
                                            <TextBlock Text="Odznacz święto, aby apteka pracowała w tym dniu. Ustawienia dotyczą każdego roku." 
                                                       FontSize="12" Foreground="#7A7A7A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="+ Dodaj święto"
                                                Click="OnShowAddHolidayClick"
                                                Background="#5D8A6B"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Padding="14,7"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <ItemsControl x:Name="HolidaysList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:HolidayRecord">
                                                <Border Padding="8,6" Background="#FAFAF9" CornerRadius="4">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <CheckBox Grid.Column="0" 
                                                                  IsChecked="{Binding IsActive}" 
                                                                  Margin="0,0,10,0"
                                                                  Click="OnHolidayToggleClick"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding DisplayText}"
                                                                   VerticalAlignment="Center" 
                                                                   FontSize="13"
                                                                   Foreground="#3A3A3A"/>
                                                        <Button Grid.Column="2" 
                                                                Content="Usuń"
                                                                FontSize="11"
                                                                Padding="10,4"
                                                                Background="#E57373"
                                                                Foreground="White"
                                                                CornerRadius="4"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                IsVisible="{Binding IsCustom}"
                                                                Click="OnDeleteHolidayClick"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- ===== SUB-TAB: Zmiany pracowników ===== -->
                        <Border x:Name="SettingsPageZmiany" IsVisible="False" Background="White" BorderBrush="#E0DDD8" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="28,24">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" MaxWidth="600">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Godziny zmian pracowników" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3A"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="+ Dodaj zmianę"
                                                Click="OnAddHourClick"
                                                Background="#5D8A6B"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Padding="14,7"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                BorderThickness="0"/>
                                    </Grid>

                                    <TextBlock x:Name="HourStatusText" Text="" FontSize="12" FontWeight="SemiBold"/>

                                    <!-- Formularz dodawania/edycji zmiany -->
                                    <Border x:Name="HourEditPanel" IsVisible="False" Background="#FAFAF9" BorderBrush="#E0DDD8" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Name="HourEditTitle" Text="Nowa zmiana" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3A"/>
                                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HourSymbolBox" PlaceholderText="np. R, P, N" CornerRadius="5" Padding="10,7" FontSize="13"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Od" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                                <TimePicker Grid.Row="1" Grid.Column="1" x:Name="HourStartTime" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Do" FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                                <TimePicker Grid.Row="2" Grid.Column="1" x:Name="HourEndTime" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                            </Grid>
                                            <CheckBox x:Name="HourIsVacation" Content="Urlop" FontSize="13" Margin="0,4,0,0" IsCheckedChanged="OnHourIsVacationChanged"/>
                                            <TextBlock x:Name="HourVacationHint" 
                                                       Text="Ustaw godziny zmiany odpowiadające wymiarowi urlopu — zostaną doliczone do sumy godzin pracy pracownika. Zmiana nie będzie wliczana do niczego innego." 
                                                       FontSize="11" 
                                                       Foreground="#7A7A7A" 
                                                       TextWrapping="Wrap" 
                                                       IsVisible="False" 
                                                       Margin="20,0,0,4"/>
                                            <TextBlock x:Name="HourEditError" Text="" FontSize="12" Foreground="#B04040"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Zapisz"
                                                        Click="OnHourSubmitClick"
                                                        Background="#5D8A6B"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"
                                                        FontSize="13"
                                                        Padding="16,7"
                                                        CornerRadius="6"
                                                        Cursor="Hand"
                                                        BorderThickness="0"/>
                                                <Button Content="Anuluj"
                                                        Click="OnHourCancelClick"
                                                        Background="#F0EFED"
                                                        Foreground="#2A2A2A"
                                                        FontSize="13"
                                                        Padding="16,7"
                                                        CornerRadius="6"
                                                        Cursor="Hand"
                                                        BorderBrush="#E0DDD8"
                                                        BorderThickness="1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lista zmian -->
                                    <ItemsControl x:Name="HoursList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:HoursRecord">
                                                <Border Padding="14,10" Background="#FAFAF9" BorderBrush="#E0DDD8" BorderThickness="1" CornerRadius="6">
                                                    <Grid ColumnDefinitions="60,*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="14" FontWeight="Bold" Foreground="#4A7C59" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                            <TextBlock Text="{Binding StartTime}" FontSize="13" Foreground="#3A3A3A"/>
                                                            <TextBlock Text="–" FontSize="13" Foreground="#9A9A9A"/>
                                                            <TextBlock Text="{Binding EndTime}" FontSize="13" Foreground="#3A3A3A"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="Edytuj"
                                                                Click="OnEditHourClick"
                                                                Tag="{Binding}"
                                                                Background="#F0EFED"
                                                                Foreground="#2A2A2A"
                                                                FontSize="12"
                                                                Padding="10,5"
                                                                CornerRadius="5"
                                                                Cursor="Hand"
                                                                BorderThickness="0"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3"
                                                                Content="Usuń"
                                                                Click="OnDeleteHourClick"
                                                                Tag="{Binding}"
                                                                Background="#FDF5F5"
                                                                Foreground="#B04040"
                                                                FontSize="12"
                                                                Padding="10,5"
                                                                CornerRadius="5"
                                                                Cursor="Hand"
                                                                BorderThickness="0"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Panel potwierdzenia usunięcia zmiany -->
                                    <Border x:Name="DeleteHourConfirmPanel" IsVisible="False"
                                            Background="#FDF5F5" CornerRadius="6" Padding="16,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Czy na pewno chcesz usunąć tę zmianę?" 
                                                       FontSize="13" Foreground="#B04040" FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Tak, usuń" Click="OnConfirmDeleteHourClick"
                                                        Background="#B04040" Foreground="White" FontSize="12"
                                                        Padding="12,6" CornerRadius="5" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="Anuluj" Click="OnCancelDeleteHourClick"
                                                        Background="White" Foreground="#2A2A2A" FontSize="12"
                                                        Padding="12,6" CornerRadius="5" BorderBrush="#E0DDD8" BorderThickness="1" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty state -->
                                    <Border x:Name="HoursEmptyState"
                                            IsVisible="False"
                                            Background="#FAFAF9"
                                            CornerRadius="6"
                                            Padding="16,28"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="#E0DDD8"
                                            BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="Brak zdefiniowanych zmian"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2A2A2A"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Dodaj pierwszą zmianę."
                                                       FontSize="12"
                                                       Foreground="#7A7A7A"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Panel>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ============ OVERLAY: Nowy Grafik ============ -->
        <Border x:Name="DialogOverlay"
                Grid.RowSpan="2"
                Background="#40000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="10"
                    Padding="28,24"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #20000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nowy grafik"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#3A3A3A"/>
                    <TextBlock Text="Wybierz miesiąc i rok dla nowego grafiku:"
                               FontSize="12"
                               Foreground="#8A8A8A"/>
                    <DatePicker x:Name="DialogDatePicker"
                                DayVisible="False"
                                MonthFormat="MMMM"
                                YearFormat="yyyy"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="DialogErrorText"
                               Text=""
                               FontSize="12"
                               Foreground="#C05050"/>
                    <Button Content="Utwórz grafik"
                            Click="OnDialogSubmitClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#5D8A6B"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderThickness="0"/>
                    <Button Content="Anuluj"
                            Click="OnDialogCancelClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#F3F2F0"
                            Foreground="#4A4A4A"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ OVERLAY: Potwierdź usunięcie grafiku ============ -->
        <Border x:Name="DeleteScheduleOverlay"
                Grid.RowSpan="2"
                Background="#40000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="10"
                    Padding="28,24"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #20000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="Usuń grafik"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#C05050"/>
                    <TextBlock x:Name="DeleteScheduleMessage"
                               Text="Czy na pewno chcesz usunąć ten grafik? Wszystkie dane zmianowe zostaną trwale usunięte."
                               FontSize="13"
                               Foreground="#4A4A4A"
                               TextWrapping="Wrap"/>
                    <Button Content="Tak, usuń grafik"
                            Click="OnConfirmDeleteScheduleClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#C05050"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderThickness="0"/>
                    <Button Content="Anuluj"
                            Click="OnCancelDeleteScheduleClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#F3F2F0"
                            Foreground="#4A4A4A"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ OVERLAY: Dodaj święto ============ -->
        <Border x:Name="AddHolidayOverlay"
                Grid.RowSpan="2"
                Background="#40000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="10"
                    Padding="28,24"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #20000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nowe święto"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#3A3A3A"/>
                    <TextBlock Text="Wybierz dzień i miesiąc, a następnie podaj nazwę. Święto będzie obowiązywać co roku."
                               FontSize="12"
                               Foreground="#8A8A8A"
                               TextWrapping="Wrap"/>
                    <DatePicker x:Name="CustomHolidayDate"
                                YearVisible="False"
                                MonthVisible="True"
                                DayVisible="True"
                                HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="CustomHolidayName"
                             Watermark="Nazwa święta, np. Wigilia"
                             FontSize="13"
                             CornerRadius="5"
                             Padding="10,7"/>
                    <TextBlock x:Name="HolidayErrorText"
                               Text=""
                               FontSize="12"
                               Foreground="#C05050"/>
                    <Button Content="Dodaj święto"
                            Click="OnAddCustomHolidayClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#5D8A6B"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderThickness="0"/>
                    <Button Content="Anuluj"
                            Click="OnCancelAddHolidayClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#F3F2F0"
                            Foreground="#4A4A4A"
                            FontSize="13"
                            Padding="14,9"
                            CornerRadius="6"
                            Cursor="Hand"
                            BorderBrush="#E8E5E0"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
