<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GrafikPlanerUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GrafikPlanerData.Models;assembly=GrafikPlanerData"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="GrafikPlanerUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Grafik Planer"
        Background="#F4F1EC"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Padding="32,16" Background="#FEFDFB" BorderBrush="#D4CFC7" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Grafik Planer" FontSize="22" FontWeight="Bold" Foreground="#2D3142"/>
                    <TextBlock Text="Zarządzanie grafikami pracy" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Górne zakładki — styl klasera -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom" Margin="0,0,0,-1">
                    <Border x:Name="TabGrafiki" 
                            Padding="20,10" 
                            CornerRadius="8,8,0,0"
                            Background="#F4F1EC"
                            BorderBrush="#D4CFC7"
                            BorderThickness="1,1,1,0"
                            Cursor="Hand"
                            PointerPressed="OnTabGrafikiClick">
                        <TextBlock Text="Grafiki" FontSize="14" FontWeight="SemiBold" Foreground="#2D3142"/>
                    </Border>
                    <Border x:Name="TabPracownicy" 
                            Padding="20,10" 
                            CornerRadius="8,8,0,0"
                            Background="#F4F1EC"
                            BorderBrush="#D4CFC7"
                            BorderThickness="1,1,1,0"
                            Cursor="Hand"
                            Margin="4,0,0,0"
                            PointerPressed="OnTabPracownicyClick">
                        <TextBlock Text="Pracownicy" FontSize="14" FontWeight="SemiBold" Foreground="#2D3142"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Row="1">
            <!-- ==================== PAGE: GRAFIKI ==================== -->
            <Border x:Name="PageGrafiki" 
                    IsVisible="True"
                    Background="#F4F1EC" 
                    Padding="32,24"
                    Opacity="1">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Text="Twoje grafiki" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#2D3142"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="+ Nowy grafik"
                                Click="OnAddNewScheduleClick"
                                Background="#4A7C59"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Padding="22,11"
                                CornerRadius="8"
                                Cursor="Hand"
                                BorderThickness="0"/>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StatusTextBlock" 
                                       Text="" 
                                       FontSize="13"
                                       FontWeight="SemiBold" 
                                       HorizontalAlignment="Left" />

                            <ItemsControl x:Name="ItemsList" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ScheduleInfo">
                                        <Button Margin="0,3"
                                                Padding="20,16"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnItemButtonClick"
                                                Tag="{Binding}"
                                                Background="White"
                                                BorderBrush="#D4CFC7"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Cursor="Hand">
                                            <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                                <Border Grid.Column="0"
                                                        Width="44" Height="44"
                                                        CornerRadius="10"
                                                        Background="#E8F0E8"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="G"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#4A7C59"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold"
                                                               FontSize="15"
                                                               Foreground="#2D3142"/>
                                                    <TextBlock Text="Kliknij aby otworzyć"
                                                               FontSize="11"
                                                               Foreground="#9CA3AF"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="→"
                                                           FontSize="18"
                                                           Foreground="#9CA3AF"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="EmptyStateText"
                                    IsVisible="False"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="40,44"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="#D4CFC7"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <Border Width="56" Height="56"
                                            CornerRadius="28"
                                            HorizontalAlignment="Center"
                                            Background="#E8F0E8">
                                        <TextBlock Text="+"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#4A7C59"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Brak grafików"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#2D3142"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Kliknij '+ Nowy grafik' aby utworzyć pierwszy."
                                               FontSize="13"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== PAGE: PRACOWNICY (Master-Detail) ==================== -->
            <Border x:Name="PagePracownicy" 
                    IsVisible="False"
                    Background="#F4F1EC" 
                    Padding="32,24"
                    Opacity="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Text="Kartoteka pracowników" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#2D3142"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="+ Dodaj pracownika"
                                Click="OnAddEmployeeClick"
                                Background="#4A7C59"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Padding="22,11"
                                CornerRadius="8"
                                Cursor="Hand"
                                BorderThickness="0"/>
                    </Grid>

                    <!-- Master-Detail layout -->
                    <Grid ColumnDefinitions="280,*">
                        <!-- LEWA KOLUMNA: Lista pracowników (zakładki klasera) -->
                        <Border Grid.Column="0" Margin="0,0,-1,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="EmployeeStatusText" 
                                               Text="" 
                                               FontSize="12"
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Left" />

                                    <ItemsControl x:Name="EmployeesList" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:EmployeeRecord">
                                                <Border Margin="0,2,0,0"
                                                        Padding="14,12"
                                                        Background="#EDE9E3"
                                                        BorderBrush="#D4CFC7"
                                                        BorderThickness="1,1,0,1"
                                                        CornerRadius="8,0,0,8"
                                                        Cursor="Hand"
                                                        PointerPressed="OnEmployeeItemClick"
                                                        Tag="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Grid.Column="0"
                                                                Width="36" Height="36"
                                                                CornerRadius="18"
                                                                Background="#E8F0E8"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FirstName[0]}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="#4A7C59"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="{Binding FirstName}" 
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#2D3142"/>
                                                                <TextBlock Text="{Binding LastName}" 
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#2D3142"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Specialisation}"
                                                                       FontSize="11"
                                                                       Foreground="#6B7280"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state pracownicy -->
                                    <Border x:Name="EmployeeEmptyState"
                                            IsVisible="False"
                                            Background="White"
                                            CornerRadius="8"
                                            Padding="20,30"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="#D4CFC7"
                                            BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="Brak pracowników"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2D3142"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Dodaj pierwszego pracownika."
                                                       FontSize="12"
                                                       Foreground="#9CA3AF"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- PRAWA KOLUMNA: Panel szczegółów -->
                        <Border Grid.Column="1"
                                Background="White"
                                BorderBrush="#D4CFC7"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,8,8,0"
                                Padding="28,24"
                                MinHeight="400">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="QuadraticEaseOut"/>
                                </Transitions>
                            </Border.Transitions>

                            <Grid>
                                <!-- Stan pusty (brak wyboru) -->
                                <StackPanel x:Name="DetailEmpty" 
                                            IsVisible="True"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" 
                                            Spacing="8">
                                    <TextBlock Text="Wybierz pracownika"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Kliknij na zakładkę po lewej aby zobaczyć szczegóły"
                                               FontSize="12"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Tryb podglądu -->
                                <ScrollViewer x:Name="DetailView" IsVisible="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16">
                                        <!-- Nagłówek -->
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="ViewFirstName" FontSize="20" FontWeight="Bold" Foreground="#2D3142"/>
                                                    <TextBlock x:Name="ViewLastName" FontSize="20" FontWeight="Bold" Foreground="#2D3142"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ViewSpec" FontSize="13" Foreground="#7B5EA7" FontWeight="Medium" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Edytuj"
                                                    Click="OnEditEmployeeClick"
                                                    Background="#EDE9E3"
                                                    Foreground="#2D3142"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Padding="16,8"
                                                    CornerRadius="6"
                                                    Cursor="Hand"
                                                    BorderThickness="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Top"/>
                                            <Button Grid.Column="2"
                                                    Content="Usuń"
                                                    Click="OnDeleteEmployeeClick"
                                                    Background="#FEF2F2"
                                                    Foreground="#DC2626"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Padding="16,8"
                                                    CornerRadius="6"
                                                    Cursor="Hand"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Top"/>
                                        </Grid>

                                        <Border Height="1" Background="#E5E1DB" Margin="0,4"/>

                                        <!-- Kontakt -->
                                        <TextBlock Text="Kontakt" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email:" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ViewEmail" FontSize="12" Foreground="#2D3142"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Telefon:" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewPhone" FontSize="12" Foreground="#2D3142" Margin="0,4,0,0"/>
                                        </Grid>

                                        <Border Height="1" Background="#E5E1DB" Margin="0,4"/>

                                        <!-- Urlop -->
                                        <TextBlock Text="Urlop" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Przysługujący (dni/rok):" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ViewVacationDays" FontSize="12" Foreground="#2D3142" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wykorzystane:" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewUsedVacation" FontSize="12" Foreground="#2D3142" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z ubiegłego roku:" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ViewUnusedVacation" FontSize="12" Foreground="#2D3142" Margin="0,4,0,0"/>
                                        </Grid>

                                        <!-- Potwierdzenie usunięcia -->
                                        <Border x:Name="DeleteConfirmPanel" IsVisible="False"
                                                Background="#FEF2F2" CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Czy na pewno chcesz usunąć tego pracownika?" 
                                                           FontSize="13" Foreground="#DC2626" FontWeight="Medium"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Tak, usuń" Click="OnConfirmDeleteClick"
                                                            Background="#DC2626" Foreground="White" FontSize="12"
                                                            Padding="12,6" CornerRadius="6" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="Anuluj" Click="OnCancelDeleteClick"
                                                            Background="White" Foreground="#2D3142" FontSize="12"
                                                            Padding="12,6" CornerRadius="6" BorderBrush="#D4CFC7" BorderThickness="1" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Tryb edycji / dodawania -->
                                <ScrollViewer x:Name="DetailEdit" IsVisible="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="EditTitle" Text="Edytuj pracownika" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#2D3142"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Imię *" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpFirstNameBox" PlaceholderText="np. Jan" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Nazwisko *" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpLastNameBox" PlaceholderText="np. Kowalski" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Specjalizacja *" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpSpecBox" PlaceholderText="np. Pielęgniarka" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Email" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpEmailBox" PlaceholderText="np. jan@email.com" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Telefon" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpPhoneBox" PlaceholderText="np. 123 456 789" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>

                                        <Border Height="1" Background="#E5E1DB" Margin="0,4"/>

                                        <TextBlock Text="Urlop" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Przysługujący urlop roczny (dni)" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpVacationDaysBox" PlaceholderText="np. 26" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Wykorzystane dni urlopu" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpUsedVacationBox" PlaceholderText="np. 5" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Niewykorzystane dni z ubiegłego roku" FontSize="12" Foreground="#6B7280" FontWeight="Medium"/>
                                            <TextBox x:Name="EmpUnusedVacationBox" PlaceholderText="np. 3" CornerRadius="6" Padding="10,8"/>
                                        </StackPanel>

                                        <TextBlock x:Name="EmployeeDialogError"
                                                   Text=""
                                                   FontSize="13"
                                                   Foreground="#DC2626"/>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <Button x:Name="EditSubmitBtn"
                                                    Content="Zapisz"
                                                    Click="OnEmployeeDialogSubmitClick"
                                                    Background="#4A7C59"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="14"
                                                    Padding="20,10"
                                                    CornerRadius="8"
                                                    Cursor="Hand"
                                                    BorderThickness="0"/>
                                            <Button Content="Anuluj"
                                                    Click="OnEmployeeDialogCancelClick"
                                                    Background="#EDE9E3"
                                                    Foreground="#2D3142"
                                                    FontSize="14"
                                                    Padding="20,10"
                                                    CornerRadius="8"
                                                    Cursor="Hand"
                                                    BorderBrush="#D4CFC7"
                                                    BorderThickness="1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ OVERLAY: Nowy Grafik ============ -->
        <Border x:Name="DialogOverlay"
                Grid.RowSpan="2"
                Background="#60000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="12"
                    Padding="30,26"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 16 48 0 #25000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="Nowy grafik"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2D3142"/>
                    <TextBlock Text="Wybierz miesiąc i rok dla nowego grafiku:"
                               FontSize="13"
                               Foreground="#6B7280"/>
                    <DatePicker x:Name="DialogDatePicker"
                                DayVisible="False"
                                MonthFormat="MMMM"
                                YearFormat="yyyy"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="DialogErrorText"
                               Text=""
                               FontSize="13"
                               Foreground="#DC2626"/>
                    <Button Content="Utwórz grafik"
                            Click="OnDialogSubmitClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#4A7C59"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Padding="16,11"
                            CornerRadius="8"
                            Cursor="Hand"
                            BorderThickness="0"/>
                    <Button Content="Anuluj"
                            Click="OnDialogCancelClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#EDE9E3"
                            Foreground="#2D3142"
                            FontSize="14"
                            Padding="16,11"
                            CornerRadius="8"
                            Cursor="Hand"
                            BorderBrush="#D4CFC7"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
